# Unifix - Function Examples
# Demonstrates user-defined functions with parameters

# Basic function
def greet() {
    print "Hello, Unifix!"
}

# Function with parameters
def add(a, b) {
    return a + b
}

# Function with multiple parameters
def multiply(x, y) {
    return x * y
}

# Function with conditionals
def absolute_value(n) {
    if n >= 0 {
        return n
    } else {
        return 0 - n
    }
}

# Function with loops
def factorial(n) {
    set result = 1
    set i = 1
    while i <= n {
        set result = result * i
        set i = i + 1
    }
    return result
}

# Function with arrays
def sum_array(arr) {
    set total = 0
    set i = 0
    while i < len(arr) {
        set total = total + arr[i]
        set i = i + 1
    }
    return total
}

# Main program
print "=== Function Examples ==="

# Call basic function
greet()

# Call function with arguments
set sum = add(5, 3)
print "5 + 3 = " + sum

set product = multiply(4, 7)
print "4 * 7 = " + product

# Test absolute value function
print "Absolute value of -10: " + absolute_value(-10)
print "Absolute value of 10: " + absolute_value(10)

# Test factorial
print "Factorial of 5: " + factorial(5)

# Test array sum
set numbers = [1, 2, 3, 4, 5]
print "Sum of [1,2,3,4,5]: " + sum_array(numbers)

print "=== All function examples completed! ==="
